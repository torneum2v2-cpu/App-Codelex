<Window x:Class="Codelex.IngresarOrden"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar orden" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>
        <SolidColorBrush x:Key="Pill" Color="#E3F7F4"/>
        <SolidColorBrush x:Key="PillText" Color="#14837A"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                    BorderThickness="1.5" CornerRadius="10">
                <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Primary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                            Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,10,10">
                                    <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#0A3737"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="4">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                        <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Volver"
                                    Width="46" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M8,18 L2,12 L8,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="32" Height="14"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M9,3 H15 V6 H9 Z M7,5 H5 A1,1 0 0 0 4,6 V20 A1,1 0 0 0 5,21 H19 A1,1 0 0 0 20,20 V6 A1,1 0 0 0 19,5 H17 M8,13 L11,16 L16,10"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ingresar orden" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Crea y gestiona las solicitudes de limpieza y servicios." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="Minimizar_Click" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="{StaticResource Surface}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Datos de la orden" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                <UniformGrid Columns="5">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="N.° de orden:" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtN_orden" Text="(automático)" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Fecha de solicitud:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpFechaSolicitud"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Fecha de limpieza:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpFechaLimpieza"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Estado:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbEstado" SelectedIndex="0">
                                            <ComboBoxItem Content="Pendiente"/>
                                            <ComboBoxItem Content="En proceso"/>
                                            <ComboBoxItem Content="Completada"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Supervisor:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbSupervisor"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Datos del cliente" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                    <TextBlock Text="RTN / N.° de identidad:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtIdentidad" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="Empresa:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtEmpresa" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="Nombre del contacto:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtContacto" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="Apellido del contacto:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtApellido" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtTelefono" IsReadOnly="True" Margin="0,0,0,8"/>

                                    <TextBlock Text="Correo electrónico:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="TxtCorreo" IsReadOnly="True" Margin="0,0,0,10"/>

                                    <TextBlock Text="Seleccione un cliente de la lista inferior." Style="{StaticResource Nota}" Margin="0,0,0,8"/>
                                    <Button x:Name="btnLimpiarCliente" Content="Limpiar cliente" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="btnLimpiarClientes"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Servicio y actividades" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Tipo de servicio:" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbTipo_Servicio" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Otras actividades disponibles:" Style="{StaticResource Etiqueta}" Margin="0,0,0,4"/>
                                            <ListBox x:Name="lstActividadesDisponibles" Height="230"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <Button x:Name="btnAgregar" Content="Agregar >" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,0,5" Click="btnAgregar_Click"/>
                                            <Button x:Name="btnQuitar" Content="&lt; Quitar" Style="{StaticResource SecondaryButton}" Width="90" Click="btnQuitar_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Actividades de la orden:" Style="{StaticResource Etiqueta}" Margin="0,0,0,4"/>
                                            <ListBox x:Name="lstActividadesOrden" Height="230"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Lugar de la limpieza" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Locación:" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbLocacion" Margin="0,0,0,8"/>

                                    <TextBlock Text="Tipo de locación:" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbTipoLocacion" Margin="0,0,0,8"/>

                                    <TextBlock Text="Dirección de la limpieza:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtDireccion_limpieza" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Text="Descripción de la limpieza:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtDescripcionLimpieza" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Empleados" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Disponibles:" Style="{StaticResource Etiqueta}"/>
                                                    <ListBox x:Name="lstEmpleadosDisponibles" Height="150"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                                    <Button x:Name="btnAgregarEmpleado" Content=">" Style="{StaticResource SecondaryButton}" Width="35" Padding="0" Margin="0,0,0,3" Click="btnAgregarEmpleado_Click"/>
                                                    <Button x:Name="btnQuitarEmpleado" Content="&lt;" Style="{StaticResource SecondaryButton}" Width="35" Padding="0" Click="btnQuitarEmpleado_Click"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Asignados:" Style="{StaticResource Etiqueta}"/>
                                                    <ListBox x:Name="lstEmpleadosAsignados" Height="150"/>
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                                <StackPanel Margin="0,0,5,0">
                                                    <TextBlock Text="Turno:" Style="{StaticResource Etiqueta}"/>
                                                    <ComboBox x:Name="cmbTurno"/>
                                                </StackPanel>
                                                <StackPanel Margin="5,0,0,0">
                                                    <TextBlock Text="Piso / área:" Style="{StaticResource Etiqueta}"/>
                                                    <TextBox x:Name="txtPiso_area"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Vehículo:" Style="{StaticResource Etiqueta}" Margin="0,8,0,5"/>
                                            <ComboBox x:Name="cmbVehiculo"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Productos y equipos a usar" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                            <TextBlock Text="Producto / equipo:" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbProducto_equipo" Margin="0,0,0,5"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="Cant:" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBox x:Name="txtCantidad" Width="60" Margin="0,0,5,0"/>
                                                <Button x:Name="btnAgregarProducto" Content="Agregar" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="btnAgregarProducto_Click"/>
                                                <Button x:Name="btnQuitarProducto" Content="Quitar" Style="{StaticResource SecondaryButton}" Click="btnQuitarProducto_Click"/>
                                            </StackPanel>

                                            <ListBox x:Name="lstProductosOrden" Height="100"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,15">
                            <Button x:Name="btnNuevaOrden" Content="Nueva orden" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,5,0" Click="btnNuevaOrden_Click"
                                    ToolTip="Limpia el formulario para registrar una orden nueva"/>
                            <Button x:Name="btnGuardarOrden" Content="Guardar orden" Style="{StaticResource PrimaryButton}"
                                    Margin="5,0,5,0" Click="btnGuardarOrden_Click"
                                    ToolTip="Guarda los datos del formulario como una orden nueva"/>
                            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                    Margin="5,0,0,0" Click="btnCancelar_Click"
                                    ToolTip="Cancela la acción actual o cierra la ventana"/>
                        </UniformGrid>

                        <Border Grid.Row="4" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Clientes existentes (haga clic en uno para llenar los datos de arriba)" Style="{StaticResource TituloCard}" FontSize="13" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Buscar:" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="txtBuscarCliente" Width="250" Margin="0,0,10,0" TextChanged="txtBuscar_TextChanged"/>
                                    <TextBlock Text="por RTN, empresa o nombre" Style="{StaticResource Nota}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataGrid x:Name="dgClientes" Style="{StaticResource Tabla}" Height="140" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="dgClientes_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="identificacionCliente" Binding="{Binding identificacionCliente}" Width="*"/>
                                        <DataGridTextColumn Header="nombreEmpresa" Binding="{Binding nombreEmpresa}" Width="*"/>
                                        <DataGridTextColumn Header="nombreCliente" Binding="{Binding nombreCliente}" Width="*"/>
                                        <DataGridTextColumn Header="apellidoCliente" Binding="{Binding apellidoCliente}" Width="*"/>
                                        <DataGridTextColumn Header="telefonoCliente" Binding="{Binding telefonoCliente}" Width="*"/>
                                        <DataGridTextColumn Header="correoCliente" Binding="{Binding correoCliente}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
