<Window x:Class="Codelex.ClienteDetalle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Codelex"
                Title="Detalle del cliente - Codelex" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
        </Style>
        <!-- Campos solo de lectura -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F7F7F7"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="Columnas" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Detalle del cliente" FontSize="20" FontWeight="Bold" Margin="4,0,0,12"/>

        <!-- Datos del cliente -->
        <GroupBox Grid.Row="1" Header="Datos del cliente">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="32"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="N.° de cliente:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtNumero"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="RTN / identidad:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="txtRTN"/>

                <TextBlock Grid.Row="1" Text="Empresa:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmpresa"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Contacto:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="1" Grid.Column="4" x:Name="txtContacto"/>

                <TextBlock Grid.Row="2" Text="Apellido contacto:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtApellido"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="2" Grid.Column="4" x:Name="txtTelefono"/>

                <TextBlock Grid.Row="3" Text="Correo electrónico:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtCorreo"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="Estado:" Style="{StaticResource Etiqueta}"/>
                <TextBox Grid.Row="3" Grid.Column="4" x:Name="txtEstado"/>
            </Grid>
        </GroupBox>

        <!-- Locaciones, órdenes y facturas -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Locaciones" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="nombreLocacion · tipoLocacion · direccion"
                               Style="{StaticResource Columnas}"/>
                    <ListBox x:Name="lstLocaciones" BorderBrush="#7A7A7A"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Órdenes" Margin="6,0,6,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="orden_id · servicio · fecha · estado"
                               Style="{StaticResource Columnas}"/>
                    <ListBox x:Name="lstOrdenes" BorderBrush="#7A7A7A"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Facturas" Margin="6,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="factura_id · fecha · estado_pago · monto"
                               Style="{StaticResource Columnas}"/>
                    <ListBox x:Name="lstFacturas" BorderBrush="#7A7A7A"/>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- Botones -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnNuevaOrden" Content="Nueva orden para este cliente" Width="208"
                        Margin="0,0,12,0" Click="NuevaOrden_Click"/>
                <Button x:Name="btnEditar" Content="Editar cliente" Width="128" Click="Editar_Click"/>
            </StackPanel>
            <Button x:Name="btnCerrar" Content="Cerrar" Width="98" HorizontalAlignment="Right"
                    Click="Cerrar_Click"/>
        </Grid>
    </Grid>
</Window>
