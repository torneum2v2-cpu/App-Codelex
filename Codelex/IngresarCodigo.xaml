<Window x:Class="Codelex.IngresarCodigo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Codelex"
          Title="Codelex - Recuperar contraseña"
          Width="580" SizeToContent="Height"
          WindowStartupLocation="CenterScreen" 
          WindowStyle="None" AllowsTransparency="True" Background="Transparent"
          ResizeMode="NoResize"
          FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="Line" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Field" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8F8F"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="MaxLength" Value="1"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="InputMethod.IsInputMethodEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{StaticResource Field}"
                              BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                              CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush"
                                      Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}"
                              CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                ShadowDepth="4" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                      Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Margin="20" CornerRadius="18" Background="{StaticResource BgGradient}" MouseLeftButtonDown="DragWindow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1">
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                    ToolTip="Minimizar">
                    <Path Data="M0,0 L10,0"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" Margin="0,8,0,0"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Close_Click"
                 ToolTip="Cerrar">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                     Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                     StrokeThickness="1.6"/>
                </Button>
            </StackPanel>
            <StackPanel x:Name="pnlStep2" Margin="30">
                <TextBlock Text="Revisa tu correo" FontSize="20" FontWeight="Bold"
                        Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                        Margin="0,16,0,0"/>
                <TextBlock x:Name="txtSentTo" Text="Ingresa el código que enviamos a tu correo."
                     FontSize="13" Foreground="{StaticResource Muted}"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="txtC1" Style="{StaticResource CodeBox}"
                        PreviewTextInput="Code_PreviewTextInput"
                        PreviewKeyDown="Code_PreviewKeyDown"
                        GotKeyboardFocus="Code_GotKeyboardFocus"/>
                    <TextBox x:Name="txtC2" Style="{StaticResource CodeBox}" Margin="10,0,0,0"
                         PreviewTextInput="Code_PreviewTextInput"
                         PreviewKeyDown="Code_PreviewKeyDown"
                         GotKeyboardFocus="Code_GotKeyboardFocus"/>
                    <TextBox x:Name="txtC3" Style="{StaticResource CodeBox}" Margin="10,0,0,0"
                         PreviewTextInput="Code_PreviewTextInput"
                          PreviewKeyDown="Code_PreviewKeyDown"
                            GotKeyboardFocus="Code_GotKeyboardFocus"/>
                    <TextBox x:Name="txtC4" Style="{StaticResource CodeBox}" Margin="10,0,0,0"
                        PreviewTextInput="Code_PreviewTextInput"
                         PreviewKeyDown="Code_PreviewKeyDown"    
                         GotKeyboardFocus="Code_GotKeyboardFocus"/>
                    <TextBox x:Name="txtC5" Style="{StaticResource CodeBox}" Margin="10,0,0,0"
                            PreviewTextInput="Code_PreviewTextInput"
                             PreviewKeyDown="Code_PreviewKeyDown"
                             GotKeyboardFocus="Code_GotKeyboardFocus"/>
                </StackPanel>

                <TextBlock x:Name="txtError2" Foreground="{StaticResource Danger}"
                     FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"
                     TextAlignment="Center" Visibility="Collapsed"/>

                <Button x:Name="btnVerify" Content="Verificar código" Margin="0,20,0,0"
                     Style="{StaticResource PrimaryButton}"
                        Click="Verify_Click"/>

                <TextBlock x:Name="txtCountdown" HorizontalAlignment="Center"
                     Margin="0,16,0,0" FontSize="12.5"
                     Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="tbResend" HorizontalAlignment="Center"
                    Margin="0,16,0,0" FontSize="12.5"
                     Foreground="{StaticResource Muted}"> ¿No te llegó? <Hyperlink Click="Resend_Click" TextDecorations="None"
                         Foreground="{StaticResource PrimaryLight}"
                         FontWeight="SemiBold">Reenviar código</Hyperlink>
                </TextBlock>

                <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12.5">
                <Hyperlink Click="ChangeEmail_Click" TextDecorations="None"
                     Foreground="{StaticResource PrimaryLight}"
                     FontWeight="SemiBold">← Cambiar correo</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
      
    </Border>
    
</Window>
