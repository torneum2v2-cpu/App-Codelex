<Window x:Class="Codelex.ActividadEditar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Codelex"
        mc:Ignorable="d"
        Title="Codelex - Actividad" Width="1180" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="ventanaCargada">
    <Window.Resources>

        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>
        <SolidColorBrush x:Key="Pill" Color="#E3F7F4"/>
        <SolidColorBrush x:Key="PillText" Color="#14837A"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                        <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                    BorderThickness="1.5" CornerRadius="10">
                <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Primary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                            Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,10,10">
                                    <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#0A3737"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>
    <Grid Margin="16">
        <Border CornerRadius="14" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="arrastrarVentana">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Volver"
                                    Width="44" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M10,20 L2,12 L10,4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="15"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Actividad" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Define sus rangos de personas, productos y equipos." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,20,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock x:Name="txtTituloActividad" Text="Datos de la actividad" Style="{StaticResource TituloCard}"/>
                                <TextBlock Text="  * obligatorio" Style="{StaticResource Nota}" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Servicio *" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbServicio"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Nombre de la actividad *" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtActividad" MaxLength="50"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Unidad *" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtUnidad" MaxLength="20" ToolTip="Cómo se mide: m², tanques, baños, escritorios..."/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Rendimiento *" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtRendimiento" MaxLength="10" PreviewTextInput="soloDecimales"
                                             ToolTip="Cuántas unidades hace una persona en una hora"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Rendimiento: unidades que una persona hace en una hora (por ejemplo, 25 m² por hora). Con él se calculan las horas y el costo."
                                       Style="{StaticResource Nota}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Personas por rango" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Cuántas personas trabajan según la medida. El primer rango empieza en 0." Style="{StaticResource Nota}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Desde *" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtDesde" MaxLength="10" PreviewTextInput="soloDecimales"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtHasta" MaxLength="10" PreviewTextInput="soloDecimales"
                                                 ToolTip="Opcional. Déjelo vacío si el último rango no tiene tope"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Personas *" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtPersonas" MaxLength="3" PreviewTextInput="soloNumeros"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Agregar rango" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="agregarRangoClic"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="Quitar el elegido" Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0" Click="quitarRangoClic"/>
                            <DataGrid x:Name="dgRangos" Style="{StaticResource Tabla}" RowHeight="34"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Desde" Binding="{Binding desde, StringFormat=N2}" Width="*"/>
                                    <DataGridTextColumn Header="Hasta" Binding="{Binding hasta, StringFormat=N2}" Width="*"/>
                                    <DataGridTextColumn Header="Personas" Binding="{Binding cantidad_personas}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Productos que usa" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Al menos uno. Lo que se gasta por cada unidad." Style="{StaticResource Nota}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Producto *" Style="{StaticResource Etiqueta}"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbProducto" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="+ Nuevo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Click="nuevoProductoClic" ToolTip="Registrar un producto nuevo"/>
                                </Grid>
                                <TextBlock Text="Cantidad por cada unidad de la actividad *" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtCantidadProducto" MaxLength="10" PreviewTextInput="soloDecimales"
                                         ToolTip="Por ejemplo 0.002 paños por cada m²"/>
                                <Button Content="Agregar producto" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="agregarProductoClic"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="Quitar el elegido" Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0" Click="quitarProductoClic"/>
                            <DataGrid x:Name="dgProductos" Style="{StaticResource Tabla}" RowHeight="34"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding nombre_producto}" Width="2*"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad_por_unidad}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Equipos que usa" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Text="Al menos uno." Style="{StaticResource Nota}" Margin="0,0,0,10"/>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Equipo *" Style="{StaticResource Etiqueta}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbEquipo" Grid.Column="0"/>
                                    <Button Grid.Column="1" Content="+ Nuevo" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Click="nuevoEquipoClic" ToolTip="Registrar un equipo nuevo"/>
                                </Grid>
                                <Button Content="Agregar equipo" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Click="agregarEquipoClic"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Bottom" Content="Quitar el elegido" Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0" Click="quitarEquipoClic"/>
                            <DataGrid x:Name="dgEquipos" Style="{StaticResource Tabla}" RowHeight="34"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Equipo" Binding="{Binding nombre_equipo}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0" HorizontalAlignment="Right" Width="380">
                        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="salirClic"/>
                        <Button x:Name="btnGuardar" Content="Guardar actividad" Style="{StaticResource PrimaryButton}" Margin="5,0,0,0"
                                Click="guardarClic" ToolTip="Guarda la actividad con sus rangos, productos y equipos"/>
                    </UniformGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
