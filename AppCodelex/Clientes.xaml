<Window x:Class="AppCodelex.Clientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppCodelex"
        mc:Ignorable="d"
        Title="Clientes - Codelex" Height="665" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,10,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Clientes"
                   FontSize="20" FontWeight="Bold" Margin="4,0,0,14"/>

        <!-- Columna izquierda: datos del cliente -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <GroupBox Header="Datos del cliente   (* obligatorio)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RTN / identidad: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRTN"/>

                    <TextBlock Grid.Row="1" Text="Empresa:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmpresa"/>

                    <TextBlock Grid.Row="2" Text="Nombre contacto: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNombre"/>

                    <TextBlock Grid.Row="3" Text="Apellido contacto:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtApellido"/>

                    <TextBlock Grid.Row="4" Text="Teléfono:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtTelefono"/>

                    <TextBlock Grid.Row="5" Text="Correo:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtCorreo"/>
                </Grid>
            </GroupBox>

            <TextBlock Text="El RTN o la identidad es único: no puede repetirse entre clientes."
                       Foreground="#777777" TextWrapping="Wrap" Margin="2,10,0,0"/>

            <Button x:Name="btnVerDetalle" Content="Ver detalle" Margin="0,24,0,0"/>

            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Button x:Name="btnNuevo" Content="Nuevo" Margin="0,0,8,0"/>
                <Button x:Name="btnCrear" Content="Crear" Margin="4,0,4,0"/>
                <Button x:Name="btnActualizar" Content="Actualizar" Margin="4,0,4,0"/>
                <Button x:Name="btnEliminar" Content="Eliminar" Margin="8,0,0,0"/>
            </UniformGrid>
        </StackPanel>

        <!-- Columna derecha: búsqueda y tabla -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Buscar clientes">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBox x:Name="txtBuscar" Width="200" Margin="0,0,16,0"/>
                    <Button x:Name="btnPorRTN" Content="Por RTN" Width="88" Margin="0,0,8,0"/>
                    <Button x:Name="btnPorNombre" Content="Por nombre" Width="98" Margin="0,0,8,0"/>
                    <Button x:Name="btnMostrarTodos" Content="Mostrar todos" Width="108"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Clientes registrados" Margin="0,8,0,0">
                <DataGrid x:Name="dgClientes"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" Background="White"
                          BorderBrush="Black" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E5E5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="identificacionCliente" Binding="{Binding identificacionCliente}" Width="*"/>
                        <DataGridTextColumn Header="nombreEmpresa" Binding="{Binding nombreEmpresa}" Width="*"/>
                        <DataGridTextColumn Header="nombreCliente" Binding="{Binding nombreCliente}" Width="*"/>
                        <DataGridTextColumn Header="telefonoCliente" Binding="{Binding telefonoCliente}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="Haga clic en un cliente de la tabla para ver su detalle."
                           Foreground="#777777" VerticalAlignment="Top" Margin="2,0,0,0"/>
                <Button x:Name="btnSalir" Content="Salir" Width="98" Height="30"
                        HorizontalAlignment="Right" Margin="0,22,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
