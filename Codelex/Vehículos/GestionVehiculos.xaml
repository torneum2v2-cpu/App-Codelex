<Window x:Class="Codelex.GestionVehiculos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Codelex"
        mc:Ignorable="d"
        Title="Codelex - Gestionar vehículos" Width="1220" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>
        <SolidColorBrush x:Key="Pill" Color="#E3F7F4"/>
        <SolidColorBrush x:Key="PillText" Color="#14837A"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                        <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Volver"
                                    Width="44" Height="38" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M10,20 L2,12 L10,4"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="26" Height="15"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M1,3 H16 V16 H1 Z M16,8 H20 L23,11 V16 H16 Z M3,18.5 A2.5,2.5 0 1 0 8,18.5 A2.5,2.5 0 1 0 3,18.5 M16,18.5 A2.5,2.5 0 1 0 21,18.5 A2.5,2.5 0 1 0 16,18.5"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Gestionar vehículos" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Consulta, edita y controla los vehículos registrados." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="Minimizar_Click" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24,20,24,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Datos del vehículo" Style="{StaticResource TituloCard}" Margin="0,0,0,16"/>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Placa *" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtPlaca" MaxLength="15" CharacterCasing="Upper"
                                         PreviewTextInput="SoloPlaca"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Marca *" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtMarca" MaxLength="20"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Modelo *" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtModelo" MaxLength="25"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <TextBlock Text="Estado:" Style="{StaticResource Etiqueta}" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <Border Background="{StaticResource Pill}" CornerRadius="8" Padding="10,3">
                                    <TextBlock x:Name="txtEstado" Text="—" Foreground="{StaticResource PillText}"
                                               FontWeight="SemiBold" FontSize="12.5"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="La placa es única: no puede repetirse entre vehículos. Un vehículo desactivado no se borra, solo deja de estar disponible."
                                       Style="{StaticResource Nota}" Margin="0,14,0,0"/>

                            <TextBlock x:Name="txtModo" Text="Seleccione un vehículo de la tabla para editarlo."
                                       Foreground="{StaticResource PillText}" FontSize="12.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <Button x:Name="btnRegistrar" Content="Registrar vehículo nuevo" Style="{StaticResource SecondaryButton}"
                                    Margin="0,18,0,0" Click="Registrar_Click"
                                    ToolTip="Abre la ventana para registrar un vehículo"/>

                            <UniformGrid Columns="3" Margin="0,10,0,0">
                                <Button x:Name="btnLimpiar" Content="Limpiar" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,5,0" Click="Limpiar_Click"
                                        ToolTip="Deja de editar y vacía el formulario"/>
                                <Button x:Name="btnActualizar" Content="Actualizar" Style="{StaticResource PrimaryButton}"
                                        Margin="5,0,5,0" Click="Actualizar_Click"
                                        ToolTip="Guarda los cambios del vehículo que se está editando"/>
                                <Button x:Name="btnCambiarEstado" Content="Desactivar" Style="{StaticResource SecondaryButton}"
                                        Margin="5,0,0,0" Click="CambiarEstado_Click"
                                        ToolTip="Activa o desactiva el vehículo (no se borra)"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Buscar vehículos" Style="{StaticResource TituloCard}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtBuscar" Grid.Column="0" Margin="0,0,10,0" KeyDown="Buscar_KeyDown"
                                             ToolTip="Escriba y presione Enter para buscar por placa, marca o modelo"/>
                                    <Button x:Name="btnBuscar" Grid.Column="1" Content="Buscar"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="Buscar_Click"/>
                                    <Button x:Name="btnMostrarTodos" Grid.Column="2" Content="Mostrar todos"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,16,0" Click="MostrarTodos_Click"/>
                                    <Button x:Name="btnActivos" Grid.Column="3" Content="Activos"
                                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Activos_Click"
                                            ToolTip="Mostrar solo los vehículos activos"/>
                                    <Button x:Name="btnInactivos" Grid.Column="4" Content="Inactivos"
                                            Style="{StaticResource SecondaryButton}" Click="Inactivos_Click"
                                            ToolTip="Mostrar solo los vehículos inactivos"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Vehículos registrados"
                                           Style="{StaticResource TituloCard}" Margin="0,0,0,12"/>
                                <DataGrid x:Name="dgVehiculos" Style="{StaticResource Tabla}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" SelectionMode="Single"
                                          PreviewMouseLeftButtonUp="dgVehiculos_Click">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Placa" Binding="{Binding placa}" Width="*"/>
                                        <DataGridTextColumn Header="Marca" Binding="{Binding marcaVehiculo}" Width="*"/>
                                        <DataGridTextColumn Header="Modelo" Binding="{Binding modeloVehiculo}" Width="*"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding estado}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="Haga clic en un vehículo de la tabla para editarlo."
                                Style="{StaticResource Nota}" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
