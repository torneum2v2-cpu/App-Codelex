<Window x:Class="Codelex.RegistrarVehiculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Codelex"
        mc:Ignorable="d"
        Title="Codelex - Registrar vehículos" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="DragWindow">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Volver"
                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M19,12 H5 M12,19 L5,12 L12,5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M1,3 H16 V16 H1 Z M16,8 H20 L23,11 V16 H16 Z M3,18.5 A2.5,2.5 0 1 0 8,18.5 A2.5,2.5 0 1 0 3,18.5 M16,18.5 A2.5,2.5 0 1 0 21,18.5 A2.5,2.5 0 1 0 16,18.5"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Registrar vehículos" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Agrega un vehículo a la flota de la empresa." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="Minimizar_Click" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Salir_Click" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="{StaticResource Surface}"/>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24,20,24,22">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Datos del vehículo" Style="{StaticResource TituloCard}"/>
                            <TextBlock Text="  * obligatorio" Style="{StaticResource Nota}" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Placa *" Style="{StaticResource Etiqueta}"/>
                            <TextBox x:Name="txtPlaca" MaxLength="15" CharacterCasing="Upper"
                                     PreviewTextInput="SoloPlaca"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Marca *" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtMarca" MaxLength="20"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Modelo *" Style="{StaticResource Etiqueta}"/>
                                <TextBox x:Name="txtModelo" MaxLength="25"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="La placa es única: no puede repetirse entre vehículos. Use solo letras, números y guion, sin espacios."
                                   Style="{StaticResource Nota}" Margin="0,14,0,0"/>

                        <UniformGrid Columns="2" Margin="0,18,0,0">
                            <Button Content="Limpiar" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,5,0" Click="Limpiar_Click"
                                ToolTip="Borra los campos del formulario"/>
                            <Button Content="Guardar" Style="{StaticResource PrimaryButton}"
                                 Margin="5,0,0,0" Click="Guardar_Click" IsDefault="True"
                                ToolTip="Registra el vehículo (también con la tecla Enter)"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
