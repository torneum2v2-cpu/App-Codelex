<Window x:Class="AppCodelex.Clientes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppCodelex"
        mc:Ignorable="d"
        Title="Clientes - Codelex" Height="665" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C8C8C8"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#D5D5D5"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,12,10,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Clientes"
                   FontSize="20" FontWeight="Bold" Margin="4,0,0,14"/>

        <!-- Columna izquierda: datos del cliente -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <GroupBox Header="Datos del cliente   (* obligatorio)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RTN / identidad: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtRTN" MaxLength="14" PreviewTextInput="SoloNumeros"/>

                    <TextBlock Grid.Row="1" Text="Empresa: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtEmpresa" MaxLength="50"/>

                    <TextBlock Grid.Row="2" Text="Nombre contacto: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtNombre" MaxLength="50"/>

                    <TextBlock Grid.Row="3" Text="Apellido contacto: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtApellido" MaxLength="50"/>

                    <TextBlock Grid.Row="4" Text="Teléfono: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtTelefono" MaxLength="8" PreviewTextInput="SoloNumeros"/>

                    <TextBlock Grid.Row="5" Text="Correo: *" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtCorreo" MaxLength="50"/>

                    <TextBlock Grid.Row="6" Text="Locación:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cbLocacion"
                              DisplayMemberPath="nombreLocacion"
                              SelectedValuePath="locacion_id"/>

                    <TextBlock Grid.Row="7" Text="Estado:" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" x:Name="txtEstado" Text="—"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </GroupBox>

            <TextBlock Text="El RTN o la identidad es único: no puede repetirse entre clientes. Debe tener 13 o 14 dígitos."
                       Foreground="#777777" TextWrapping="Wrap" Margin="2,10,0,0"/>

            <TextBlock x:Name="txtModo" Text="Nuevo cliente: llene los datos y presione Crear."
                       Foreground="#1F6FB2" TextWrapping="Wrap" Margin="2,6,0,0"/>

            <Button x:Name="btnVerDetalle" Content="Ver detalle" Margin="0,16,0,0"
                    Click="VerDetalle_Click"/>

            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Button x:Name="btnNuevo" Content="Nuevo" Margin="0,0,8,0" Click="Nuevo_Click"
                        ToolTip="Limpia el formulario para registrar un cliente nuevo"/>
                <Button x:Name="btnCrear" Content="Crear" Margin="4,0,4,0" Click="Crear_Click"
                        ToolTip="Guarda los datos del formulario como un cliente nuevo"/>
                <Button x:Name="btnActualizar" Content="Actualizar" Margin="4,0,4,0" Click="Actualizar_Click"
                        ToolTip="Guarda los cambios del cliente que se está editando"/>
                <Button x:Name="btnCambiarEstado" Content="Desactivar" Margin="8,0,0,0" Click="CambiarEstado_Click"
                        ToolTip="Activa o desactiva el cliente (no se borra)"/>
            </UniformGrid>
        </StackPanel>

        <!-- Columna derecha: búsqueda y tabla -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Buscar clientes">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <TextBox x:Name="txtBuscar" Width="170" Margin="0,0,12,0" KeyDown="Buscar_KeyDown"/>
                    <Button x:Name="btnPorRTN" Content="Por RTN" Width="80" Margin="0,0,6,0" Click="PorRTN_Click"/>
                    <Button x:Name="btnPorNombre" Content="Por nombre" Width="90" Margin="0,0,6,0" Click="PorNombre_Click"/>
                    <Button x:Name="btnMostrarTodos" Content="Mostrar todos" Width="100" Margin="0,0,20,0" Click="MostrarTodos_Click"/>
                    <Button x:Name="btnActivos" Content="Activos" Width="80" Margin="0,0,6,0" Click="Activos_Click"
                            ToolTip="Mostrar solo los clientes activos"/>
                    <Button x:Name="btnInactivos" Content="Inactivos" Width="80" Click="Inactivos_Click"
                            ToolTip="Mostrar solo los clientes inactivos"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Clientes registrados" Margin="0,8,0,0">
                <DataGrid x:Name="dgClientes"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" Background="White"
                          BorderBrush="Black" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5E5E5"
                          Cursor="Hand"
                          SelectionChanged="dgClientes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="identificacionCliente" Binding="{Binding identificacionCliente}" Width="*"/>
                        <DataGridTextColumn Header="nombreEmpresa" Binding="{Binding nombreEmpresa}" Width="*"/>
                        <DataGridTextColumn Header="nombreCliente" Binding="{Binding nombreCliente}" Width="*"/>
                        <DataGridTextColumn Header="telefonoCliente" Binding="{Binding telefonoCliente}" Width="*"/>
                        <DataGridTextColumn Header="estado" Binding="{Binding estado}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="Haga clic en un cliente de la tabla para ver su detalle."
                           Foreground="#777777" VerticalAlignment="Top" Margin="2,0,0,0"/>
                <Button x:Name="btnSalir" Content="Salir" Width="98" Height="30"
                        HorizontalAlignment="Right" Margin="0,22,0,0" Click="Salir_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
