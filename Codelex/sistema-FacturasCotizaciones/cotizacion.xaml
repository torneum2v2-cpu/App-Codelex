<Window x:Class="Codelex.FacturasCotizaciones.Cotizacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cotizaciones" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=txtIdentidad}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="estilos-documento.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado Superior -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="arrastrarVentana">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Volver"
                                    Width="46" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M8,18 L2,12 L8,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="32" Height="14"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M12,1 V23 M17,5 H9.5 A3.5,3.5 0 0 0 9.5,12 H14.5 A3.5,3.5 0 0 1 14.5,19 H6"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Cotizaciones" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Prepare la propuesta de precios para el cliente." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="minimizarClic" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fondo del contenido (evita el borde claro en las esquinas verdes) -->
                <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="{StaticResource Surface}"/>

                <!-- Contenedor Principal -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- SECCIÓN 1: Datos de la cotización -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Datos de la cotización" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="N.° de cotización:" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtNDocumento" Text="(automático)" IsReadOnly="True"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Fecha:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpFecha"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Válida hasta:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpValidaHasta"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 2: Datos del cliente y Lugar del servicio -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Columna Izquierda: Datos del cliente -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="Datos del cliente" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                    <TextBlock Text="RTN / N.° de identidad:" Style="{StaticResource Etiqueta}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtIdentidad" Grid.Column="0" Margin="0,0,8,0"/>
                                        <Button x:Name="btnBuscarCliente" Grid.Column="1" Width="38" Padding="0"
                                                Style="{StaticResource PrimaryButton}" Click="buscarClienteClic"
                                                ToolTip="Buscar cliente registrado">
                                            <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M21,21 L16,16" Stroke="#06282B" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                                  Width="16" Height="16"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="Empresa:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtEmpresa" Margin="0,0,0,8"/>

                                    <TextBlock Text="Nombre del contacto:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtContacto" Margin="0,0,0,8"/>

                                    <TextBlock Text="Apellido del contacto:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtApellido" Margin="0,0,0,8"/>

                                    <TextBlock Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtTelefono" Margin="0,0,0,8" ToolTip="Escriba los 8 dígitos, sin +504. Se mostrará como +504 XXXX-XXXX"/>

                                    <TextBlock Text="Correo electrónico:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtCorreo" Margin="0,0,0,10"/>

                                    <TextBlock Text="Use la lupa para elegir un cliente registrado o escriba los datos de uno nuevo." Style="{StaticResource Nota}" Margin="0,0,0,8"/>
                                    <Button x:Name="btnLimpiarCliente" Content="Limpiar cliente" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="limpiarClientes"/>
                                </StackPanel>
                            </Border>

                            <!-- Columna Derecha: Lugar del servicio -->
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Lugar del servicio" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                    <TextBlock Text="Locación:" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbLocacion" Margin="0,0,0,8"/>

                                    <TextBlock Text="Tipo de locación:" Style="{StaticResource Etiqueta}"/>
                                    <ComboBox x:Name="cmbTipoLocacion" Margin="0,0,0,8"/>

                                    <TextBlock Text="Dirección:" Style="{StaticResource Etiqueta}"/>
                                    <TextBox x:Name="txtDireccion" Height="70" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <TextBlock Text="Para un cliente nuevo, escriba la dirección del servicio." Style="{StaticResource Nota}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- SECCIÓN 3: Servicio y actividades -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Servicio y actividades" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Servicio:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbServicio"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Agregar otra actividad:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbOtraActividad"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text=" " Style="{StaticResource Etiqueta}"/>
                                        <Button x:Name="btnAgregarLinea" Content="Agregar" Style="{StaticResource PrimaryButton}"
                                                Width="100" Click="agregarLineaClic"
                                                ToolTip="Agrega la actividad elegida a la cotización"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text=" " Style="{StaticResource Etiqueta}"/>
                                        <Button x:Name="btnQuitarLinea" Content="Quitar" Style="{StaticResource SecondaryButton}"
                                                Width="100" Click="quitarLineaClic"
                                                ToolTip="Quita la actividad seleccionada"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid x:Name="dgLineas" Style="{StaticResource Tabla}" Height="220" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                                          SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Actividad" Binding="{Binding Nombre, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="Se mide en" Binding="{Binding Unidad, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                                        <DataGridTemplateColumn Header="Cantidad" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Style="{StaticResource CeldaCantidad}"
                                                             Text="{Binding Medida, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             MaxLength="12" LostFocus="medidaFocoPerdido"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Personas" Binding="{Binding Personas, Mode=OneWay}" IsReadOnly="True" Width="100"/>
                                        <DataGridTextColumn Header="Precio (L)" Binding="{Binding Precio, Mode=OneWay, StringFormat=N2}" IsReadOnly="True" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Escriba cuántos m² o unidades tiene cada actividad. El precio y las personas se calculan solos."
                                           Style="{StaticResource Nota}" Margin="0,6,0,0"/>

                                <!-- Observaciones y totales -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Observaciones:" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtObservaciones" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Personas necesarias:" Style="{StaticResource Etiqueta}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="lblPersonas" Grid.Row="4" Grid.Column="1" Text="0" Foreground="{StaticResource DarkText}" FontSize="13.5" Margin="0,6,0,0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" Style="{StaticResource Etiqueta}"/>
                                        <TextBlock x:Name="lblSubtotal" Grid.Row="0" Grid.Column="1" Text="L 0.00" Foreground="{StaticResource DarkText}" FontSize="13.5"/>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                                            <TextBlock Text="Descuento (%):" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="txtDescuento" Text="0" Width="64" Height="30" FontSize="13" MaxLength="5"
                                                     PreviewTextInput="soloDecimales" TextChanged="descuentoCambiado"
                                                     ToolTip="Porcentaje de descuento sobre el subtotal (0 a 99). El ISV se calcula después del descuento"/>
                                        </StackPanel>
                                        <TextBlock x:Name="lblDescuento" Grid.Row="1" Grid.Column="1" Text="- L 0.00" Foreground="{StaticResource DarkText}" FontSize="13.5" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ISV (15%):" Style="{StaticResource Etiqueta}" Margin="0,4,0,5"/>
                                        <TextBlock x:Name="lblIsv" Grid.Row="2" Grid.Column="1" Text="L 0.00" Foreground="{StaticResource DarkText}" FontSize="13.5" Margin="0,4,0,0"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Total a pagar:" Style="{StaticResource TituloCard}" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="lblTotal" Grid.Row="3" Grid.Column="1" Text="L 0.00" Style="{StaticResource TituloCard}" Margin="0,6,0,0"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECCIÓN 4: Botones de acción -->
                        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,15">
                            <Button x:Name="btnNuevoDocumento" Content="Nueva cotización" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,5,0" Click="nuevoDocumentoClic"
                                    ToolTip="Limpia el formulario para empezar una nueva"/>
                            <Button x:Name="btnGuardar" Content="Guardar cotización" Style="{StaticResource PrimaryButton}"
                                    Margin="5,0,5,0" Click="guardarClic"
                                    ToolTip="Guarda la cotización"/>
                            <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                    Margin="5,0,0,0" Click="cancelarClic"
                                    ToolTip="Cierra la ventana"/>
                        </UniformGrid>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>