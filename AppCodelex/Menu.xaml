<Window x:Class="AppCodelex.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AppCodelex"
        Title="Sistema Codelex" Width="1100" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Bg}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardHover" Color="#F7FBFA"/>
        <SolidColorBrush x:Key="CardBorderHover" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="Ink" Color="#2B2B2B"/>
        <SolidColorBrush x:Key="Muted" Color="#555555"/>
        <SolidColorBrush x:Key="Icon" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="Hole" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LogoGreen" Color="#2E8B3A"/>
        <SolidColorBrush x:Key="LogoBlue" Color="#1F5FA8"/>

        <!-- Tarjeta de módulo (sin funcionalidad por ahora) -->
        <Style x:Key="ModuleCard" TargetType="Button">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Margin" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                Padding="20,0,16,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource CardHover}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CardBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Contenedor del icono: lienzo de 48x48 escalado -->
        <Style x:Key="CardIcon" TargetType="Viewbox">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="15"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12,10,12,24">

        <!-- Logo -->
        <!-- Cuando agreguen la imagen del logo al proyecto, reemplazar el contenido
             de este Border por: <Image Source="Imagenes/logo.png" Stretch="Uniform"/> -->

        <Image Height="117" Source="/Image2.png" Stretch="Fill" Width="184"/>

        <TextBlock Text="¿Qué desea hacer?" HorizontalAlignment="Center"
                   Margin="0,20,0,14"
                   FontSize="30" FontWeight="Bold"
                   Foreground="{StaticResource Ink}"/>

        <!-- Fila 1 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            <!-- Órdenes -->
            <Button x:Name="btnOrdenes" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Rectangle Canvas.Left="8" Canvas.Top="6" Width="32" Height="40"
                                       RadiusX="4" RadiusY="4" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="16" Canvas.Top="2" Width="16" Height="9"
                                       RadiusX="3" RadiusY="3" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="15" Canvas.Top="13" Width="18" Height="2"
                                       Fill="{StaticResource Hole}"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="21" Width="5" Height="5"
                                     Fill="{StaticResource Hole}"/>
                            <Rectangle Canvas.Left="22" Canvas.Top="22" Width="12" Height="3"
                                       RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Hole}"/>
                            <Ellipse Canvas.Left="14" Canvas.Top="31" Width="5" Height="5"
                                     Fill="{StaticResource Hole}"/>
                            <Rectangle Canvas.Left="22" Canvas.Top="32" Width="12" Height="3"
                                       RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Hole}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Órdenes" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Nueva orden, cliente existente e historial de órdenes"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Clientes -->
            <Button x:Name="btnClientes" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Ellipse Canvas.Left="3" Canvas.Top="12" Width="11" Height="11"
                                     Fill="{StaticResource Icon}"/>
                            <Ellipse Canvas.Left="34" Canvas.Top="12" Width="11" Height="11"
                                     Fill="{StaticResource Icon}"/>
                            <Path Fill="{StaticResource Icon}"
                                  Data="M0,38 V32 A6,6 0 0 1 6,26 H12 V38 Z"/>
                            <Path Fill="{StaticResource Icon}"
                                  Data="M48,38 V32 A6,6 0 0 0 42,26 H36 V38 Z"/>
                            <Ellipse Canvas.Left="17" Canvas.Top="7" Width="14" Height="14"
                                     Fill="{StaticResource Icon}"/>
                            <Path Fill="{StaticResource Icon}" Stroke="{StaticResource Hole}" StrokeThickness="2"
                                  Data="M12,40 V31 A8,8 0 0 1 20,23 H28 A8,8 0 0 1 36,31 V40 Z"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clientes" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Consultar, agregar y ver el detalle de clientes"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Cotizaciones y facturación -->
            <Button x:Name="btnCotizaciones" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Path Fill="{StaticResource Icon}"
                                  Data="M12,2 H29 L40,13 V42 A4,4 0 0 1 36,46 H12 A4,4 0 0 1 8,42 V6 A4,4 0 0 1 12,2 Z"/>
                            <Path Stroke="{StaticResource Hole}" StrokeThickness="2"
                                  Data="M29,2 V13 H40"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="9" Width="10" Height="2.5"
                                       Fill="{StaticResource Hole}"/>
                            <Rectangle Canvas.Left="13" Canvas.Top="14" Width="10" Height="2.5"
                                       Fill="{StaticResource Hole}"/>
                            <TextBlock Canvas.Left="17" Canvas.Top="18" Text="$"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource Hole}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cotizaciones y facturación" Style="{StaticResource CardTitle}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Cotizar y facturar órdenes"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Empleados -->
            <Button x:Name="btnEmpleados" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Rectangle Canvas.Left="10" Canvas.Top="3" Width="28" Height="42"
                                       RadiusX="4" RadiusY="4" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="19" Canvas.Top="8" Width="10" Height="3"
                                       RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource Hole}"/>
                            <Ellipse Canvas.Left="18.5" Canvas.Top="16" Width="11" Height="11"
                                     Fill="{StaticResource Hole}"/>
                            <Path Fill="{StaticResource Hole}"
                                  Data="M15,38 V35 A6,6 0 0 1 21,29 H27 A6,6 0 0 1 33,35 V38 Z"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Empleados" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Ingresar, gestionar y consultar empleados"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </StackPanel>

        <!-- Fila 2 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

            <!-- Inventario -->
            <Button x:Name="btnInventario" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Rectangle Canvas.Left="14" Canvas.Top="3" Width="20" Height="19"
                                       RadiusX="2" RadiusY="2" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="21" Canvas.Top="3" Width="6" Height="7"
                                       Fill="{StaticResource Hole}"/>
                            <Rectangle Canvas.Left="2" Canvas.Top="25" Width="21" Height="20"
                                       RadiusX="2" RadiusY="2" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="9.5" Canvas.Top="25" Width="6" Height="7"
                                       Fill="{StaticResource Hole}"/>
                            <Rectangle Canvas.Left="25" Canvas.Top="25" Width="21" Height="20"
                                       RadiusX="2" RadiusY="2" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="32.5" Canvas.Top="25" Width="6" Height="7"
                                       Fill="{StaticResource Hole}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Inventario" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Productos, equipos y proveedores"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Reportes -->
            <Button x:Name="btnReportes" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Rectangle Canvas.Left="3" Canvas.Top="5" Width="5" Height="39"
                                       RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="3" Canvas.Top="39" Width="43" Height="5"
                                       RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="11" Width="14" Height="5"
                                       RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="20" Width="22" Height="5"
                                       RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Icon}"/>
                            <Rectangle Canvas.Left="12" Canvas.Top="29" Width="30" Height="5"
                                       RadiusX="2.5" RadiusY="2.5" Fill="{StaticResource Icon}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reportes" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Reportes de órdenes y de empleados"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <!-- Usuarios -->
            <Button x:Name="btnUsuarios" Style="{StaticResource ModuleCard}">
                <DockPanel>
                    <Viewbox Style="{StaticResource CardIcon}">
                        <Canvas Width="48" Height="48">
                            <Ellipse Canvas.Left="7" Canvas.Top="4" Width="17" Height="17"
                                     Fill="{StaticResource Icon}"/>
                            <Path Fill="{StaticResource Icon}"
                                  Data="M1,44 V38 A12,12 0 0 1 13,26 H24 V44 Z"/>
                            <Path Fill="{StaticResource Icon}" Stroke="{StaticResource Hole}" StrokeThickness="2.5"
                                  Data="M36,21 L47,25.5 V32 C47,39 42.5,43.5 36,46 C29.5,43.5 25,39 25,32 V25.5 Z"/>
                            <Path Fill="{StaticResource Hole}"
                                  Data="M36,26 L43,29 V32.5 C43,37 40.5,40 36,42 Z"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Usuarios" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="Usuarios, cargos y accesos al sistema"
                                   Style="{StaticResource CardText}"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </StackPanel>
        <Image Height="100" Width="100"/>
    </StackPanel>
</Window>
