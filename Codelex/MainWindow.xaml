<Window x:Class="Codelex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codelex - Iniciar sesión"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Label" Color="#D6F5F0"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="Line" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Field" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8F8F"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="14,0"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Primary}"/>
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource Muted}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}"
                                CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16"
                                                  ShadowDepth="4" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Width="28" Height="28">
                            <Path x:Name="eye" Style="{StaticResource FieldIcon}"
                                  Data="M2,12 C5,6 19,6 22,12 C19,18 5,18 2,12 Z M12,15 A3,3 0 1 0 12,9 A3,3 0 0 0 12,15 Z"/>
                            <Path x:Name="slash" Style="{StaticResource FieldIcon}"
                                  Data="M4,4 L20,20" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="slash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="eye" Property="Stroke"
                                        Value="{StaticResource Primary}"/>
                                <Setter TargetName="slash" Property="Stroke"
                                        Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="eye" Property="Stroke"
                                        Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" CornerRadius="18" Background="{StaticResource BgGradient}"
            MouseLeftButtonDown="DragWindow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid>
          
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1">
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                        ToolTip="Minimizar">
                    <Path Data="M0,0 L10,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" Margin="0,8,0,0"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Close_Click"
                        ToolTip="Cerrar">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"/>
                </Button>
            </StackPanel>

            <StackPanel Margin="44,26,44,26">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Viewbox Height="46" Stretch="Uniform" VerticalAlignment="Center">
                        <Canvas Width="32.9" Height="41.8">
                            <Canvas Canvas.Left="-3.4" Canvas.Top="-14.4">
                                <Canvas Canvas.Left="3" Canvas.Top="15">
                                    <Path Data="M3,9 V4 Q3,0 7,0 H21 Q24,0 24,3 V7 H15 V9 Z" Fill="White"/>
                                    <Path Data="M17.6,8.8 H23.4 L21.8,17 Q21.5,18.8 19.7,18.8 H17.6 Z" Fill="White"/>
                                    <Path Data="M7,8 H15 V17.6 H7 Z" Fill="White"/>
                                    <Path Data="F0 M7,19.6 H14 Q20,19.6 20,25.6 V34.6 Q20,40.6 14,40.6 H7 Q1,40.6 1,34.6 V25.6 Q1,19.6 7,19.6 Z M10.5,25.0 Q11.58,29.32 15.9,30.4 Q11.58,31.48 10.5,35.8 Q9.42,31.48 5.1,30.4 Q9.42,29.32 10.5,25.0 Z" Fill="White"/>
                                    <Path Data="M26.6,2.4 A1.6,1.6 0 1 0 29.8,2.4 A1.6,1.6 0 1 0 26.6,2.4 Z" Fill="White"/>
                                    <Path Data="M30.15,6.8 A1.25,1.25 0 1 0 32.65,6.8 A1.25,1.25 0 1 0 30.15,6.8 Z" Fill="White"/>
                                    <Path Data="M27.55,11 A1.05,1.05 0 1 0 29.65,11 A1.05,1.05 0 1 0 27.55,11 Z" Fill="White"/>
                                </Canvas>
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Codelex" Foreground="White" FontSize="36"
                               FontWeight="Bold" VerticalAlignment="Center"
                               Margin="2,0,0,0"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Usuario" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource FieldIcon}"
                                      Data="M12,11 A4,4 0 1 0 12,3 A4,4 0 0 0 12,11 Z M4,21 C4,16.5 7.5,14 12,14 C16.5,14 20,16.5 20,21"/>
                                <TextBox x:Name="txtUser" Grid.Column="1" Margin="12,0,0,0"
                                         Style="{StaticResource FlatTextBox}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contraseña" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Label}" Margin="0,0,0,6"/>
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource FieldIcon}"
                                      Data="M5,11 H19 V21 H5 Z M8,11 V7 A4,4 0 0 1 16,7 V11"/>
                                <PasswordBox x:Name="txtPassword" Grid.Column="1" Margin="12,0,0,0"
                                             Style="{StaticResource FlatPasswordBox}"/>
                                <TextBox x:Name="txtPasswordVisible" Grid.Column="1" Margin="12,0,0,0"
                                         Style="{StaticResource FlatTextBox}" Visibility="Collapsed"/>
                                <ToggleButton x:Name="btnShowPassword" Grid.Column="2"
                                              Style="{StaticResource EyeToggle}"
                                              ToolTip="Mostrar u ocultar contraseña"
                                              Checked="ShowPassword_Changed"
                                              Unchecked="ShowPassword_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <CheckBox x:Name="chkRemember" Content="Recordarme"
                              Foreground="{StaticResource Label}" FontSize="12.5"
                              VerticalContentAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Right" FontSize="12.5">
                        <Hyperlink Click="ForgotPassword_Click" TextDecorations="None"
                                   Foreground="{StaticResource PrimaryLight}"
                                   FontWeight="SemiBold">¿Olvidaste tu contraseña?</Hyperlink>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="txtError" Foreground="{StaticResource Danger}"
                           FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Button x:Name="btnLogin" Content="Iniciar sesión" Margin="0,18,0,0"
                        Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Login_Click"/>

                <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12.5"
                           Foreground="{StaticResource Muted}">
                    ¿Necesitas acceso? <Hyperlink Click="RequestAccess_Click"
                                                TextDecorations="None"
                                                Foreground="{StaticResource PrimaryLight}"
                                                FontWeight="SemiBold">Contacta al administrador</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
