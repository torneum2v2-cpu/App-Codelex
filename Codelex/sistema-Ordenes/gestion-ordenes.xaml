<Window x:Class="Codelex.Ordenes.GestionOrdenes"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de órdenes" Height="800" Width="1350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" FontFamily="Segoe UI"
        Loaded="ventanaCargada">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>
        <SolidColorBrush x:Key="Pill" Color="#E3F7F4"/>
        <SolidColorBrush x:Key="PillText" Color="#14837A"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ResumenNumero" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                    BorderThickness="1.5" CornerRadius="10">
                <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Primary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,10,10">
                                    <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#0A3737"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="4">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tabla" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource Surface}"/>
                        <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="arrastrarVentana">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Volver"
                                    Width="46" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M8,18 L2,12 L8,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="32" Height="14"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M4,6 H20 M4,12 H20 M4,18 H20 M2,6 H2.1 M2,12 H2.1 M2,18 H2.1"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Gestión de órdenes" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Consulta, filtra y administra las órdenes ya ingresadas." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="minimizarClic" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="{StaticResource Surface}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Resumen -->
                        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,15">
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total de órdenes" Style="{StaticResource Etiqueta}" Margin="0"/>
                                    <TextBlock x:Name="txtTotal" Text="0" Style="{StaticResource ResumenNumero}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Pendientes" Style="{StaticResource Etiqueta}" Margin="0"/>
                                    <TextBlock x:Name="txtPendientes" Text="0" Style="{StaticResource ResumenNumero}" Foreground="#9A6B00"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="En proceso" Style="{StaticResource Etiqueta}" Margin="0"/>
                                    <TextBlock x:Name="txtEnProceso" Text="0" Style="{StaticResource ResumenNumero}" Foreground="#1F6FB2"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="5,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="Completadas" Style="{StaticResource Etiqueta}" Margin="0"/>
                                    <TextBlock x:Name="txtCompletadas" Text="0" Style="{StaticResource ResumenNumero}" Foreground="{StaticResource PillText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Canceladas" Style="{StaticResource Etiqueta}" Margin="0"/>
                                    <TextBlock x:Name="txtCanceladas" Text="0" Style="{StaticResource ResumenNumero}" Foreground="#B03A3A"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Filtros -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Filtros" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Buscar:" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtBuscar" TextChanged="buscarTextoCambiado"
                                                 ToolTip="N.° de orden, RTN, empresa o nombre del contacto"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Estado:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbFiltroEstado" SelectionChanged="filtroCambiado"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="Supervisor:" Style="{StaticResource Etiqueta}"/>
                                        <ComboBox x:Name="cmbFiltroSupervisor" SelectionChanged="filtroCambiado"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                        <TextBlock Text="Fecha de limpieza desde:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpDesde" SelectedDateChanged="filtroCambiado"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                        <TextBlock Text="Hasta:" Style="{StaticResource Etiqueta}"/>
                                        <DatePicker x:Name="dpHasta" SelectedDateChanged="filtroCambiado"/>
                                    </StackPanel>
                                    <Button Grid.Column="5" Content="Limpiar filtros" Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Bottom" Click="limpiarFiltrosClic"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Lista + detalle -->
                        <Grid Grid.Row="2" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="380"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0" Padding="20,20,20,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Órdenes ingresadas" Style="{StaticResource TituloCard}"/>
                                        <TextBlock x:Name="txtConteo" Style="{StaticResource Nota}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataGrid x:Name="dgOrdenes" Style="{StaticResource Tabla}" Height="520"
                                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                              SelectionMode="Single" SelectionChanged="ordenesSeleccionCambiada">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="N.° orden" Binding="{Binding OrdenId}" Width="100"/>
                                            <DataGridTextColumn Header="Solicitud" Binding="{Binding FechaSolicitud, StringFormat=dd/MM/yyyy}" Width="95"/>
                                            <DataGridTextColumn Header="Limpieza" Binding="{Binding FechaServicio, StringFormat=dd/MM/yyyy}" Width="95"/>
                                            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                                            <DataGridTextColumn Header="Servicio" Binding="{Binding Servicio}" Width="*"/>
                                            <DataGridTextColumn Header="Supervisor" Binding="{Binding Supervisor}" Width="*"/>
                                            <DataGridTemplateColumn Header="Estado" Width="115">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding EstadoFondo}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Estado}" Foreground="{Binding EstadoTexto}"
                                                                       FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="560">
                                    <StackPanel Margin="0,0,6,0">
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Detalle de la orden" Style="{StaticResource TituloCard}"/>
                                            <Border x:Name="pillEstado" CornerRadius="10" Padding="10,3" HorizontalAlignment="Right" Visibility="Collapsed">
                                                <TextBlock x:Name="txtPillEstado" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock x:Name="txtSinSeleccion" Text="Seleccione una orden de la lista para ver su detalle."
                                                   Style="{StaticResource Nota}"/>

                                        <StackPanel x:Name="panelDetalle" Visibility="Collapsed">
                                            <TextBlock Text="N.° de orden:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dOrden" Style="{StaticResource Valor}" FontWeight="Bold"/>

                                            <TextBlock Text="Cliente:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dCliente" Style="{StaticResource Valor}"/>

                                            <TextBlock Text="Lugar de la limpieza:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dLugar" Style="{StaticResource Valor}"/>

                                            <TextBlock Text="Vehículo:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dVehiculo" Style="{StaticResource Valor}"/>

                                            <TextBlock Text="Observaciones:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dObservaciones" Style="{StaticResource Valor}"/>

                                            <TextBlock Text="Conformidad del cliente:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dConformidad" Style="{StaticResource Valor}"/>
                                            <StackPanel x:Name="panelConformidad" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                                <Button Content="Cliente conforme" Style="{StaticResource SecondaryButton}"
                                                        Width="150" Margin="0,0,8,0" Click="conformeClic"
                                                        ToolTip="Registra que el cliente quedó conforme con el servicio"/>
                                                <Button Content="No conforme" Style="{StaticResource SecondaryButton}"
                                                        Width="130" Click="noConformeClic"
                                                        ToolTip="Registra que el cliente no quedó conforme con el servicio"/>
                                            </StackPanel>

                                            <TextBlock Text="Factura:" Style="{StaticResource Etiqueta}"/>
                                            <TextBlock x:Name="dFactura" Style="{StaticResource Valor}"/>

                                            <TextBlock Text="Actividades:" Style="{StaticResource Etiqueta}"/>
                                            <ListBox x:Name="lstActividades" Height="100" Margin="0,0,0,6"/>
                                            <Button x:Name="btnMarcarActividad" Content="Marcar / desmarcar como hecha"
                                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                                    Width="230" Margin="0,0,0,10" Click="marcarActividadClic" Visibility="Collapsed"
                                                    ToolTip="Seleccione una actividad de la lista. Todas deben estar hechas para completar la orden"/>

                                            <TextBlock Text="Empleados asignados:" Style="{StaticResource Etiqueta}"/>
                                            <ListBox x:Name="lstEmpleados" Height="100" Margin="0,0,0,10"/>

                                            <TextBlock Text="Productos y equipos:" Style="{StaticResource Etiqueta}"/>
                                            <ListBox x:Name="lstProductos" Height="100"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Acciones -->
                        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Cambiar estado a:" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="cmbCambiarEstado" Width="170" Margin="0,0,10,0"/>
                                    <Button x:Name="btnAplicarEstado" Content="Aplicar estado" Style="{StaticResource PrimaryButton}"
                                            Click="aplicarEstadoClic" IsEnabled="False"/>
                                    <Button x:Name="btnCancelarOrden" Content="Cancelar orden" Style="{StaticResource SecondaryButton}"
                                            Margin="10,0,0,0" Click="cancelarOrdenClic" IsEnabled="False"
                                            ToolTip="Marca la orden como Cancelada (no borra el registro)"/>
                                    <Button x:Name="btnCrearFactura" Content="Crear factura" Style="{StaticResource PrimaryButton}"
                                            Margin="10,0,0,0" Click="crearFacturaClic" Visibility="Collapsed"
                                            ToolTip="Factura esta orden completada"/>
                                    <Button x:Name="btnVerFactura" Content="Ver factura" Style="{StaticResource PrimaryButton}"
                                            Margin="10,0,0,0" Click="verFacturaClic" Visibility="Collapsed"
                                            ToolTip="Muestra la factura de esta orden"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button x:Name="btnActualizar" Content="Actualizar" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,10,0" Click="actualizarClic"/>
                                    <Button x:Name="btnNuevaOrden" Content="Nueva orden" Style="{StaticResource PrimaryButton}"
                                            Click="nuevaOrdenClic"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>