<Window x:Class="Codelex.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Codelex"
        Title="Codelex - Menú" Width="992" Height="652"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Paleta (misma del login) -->
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Label" Color="#D6F5F0"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <!-- Icono de línea del menú lateral (toma el color del botón) -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Icono blanco dentro de las tarjetas -->
        <Style x:Key="CardIcon" TargetType="Path">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Botón del menú lateral -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Label}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="20" CornerRadius="2"
                                        HorizontalAlignment="Left" Opacity="0"
                                        Background="{StaticResource Primary}"/>
                                <ContentPresenter Margin="18,0,12,0" VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de cerrar sesión -->
        <Style x:Key="LogoutButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Tarjeta de módulo -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="16" Padding="24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="#F3FCFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de ventana (minimizar / cerrar) -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ButtonGradient}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margen para que se vea la sombra de la ventana -->
    <Grid Margin="16">
        <Border CornerRadius="14" Background="{StaticResource Surface}" MouseLeftButtonDown="DragWindow">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ PANEL LATERAL ============ -->
                <Border Grid.Column="0" CornerRadius="14,0,0,14" Background="{StaticResource BgGradient}">
                    <DockPanel Margin="18,26,18,22">

                        <!-- Marca -->
                        <StackPanel DockPanel.Dock="Top" Margin="6,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="10"
                                        Background="{StaticResource ButtonGradient}">
                                    <TextBlock Text="C" Foreground="White" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Codelex" Foreground="White" FontSize="22" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="MENÚ" Foreground="{StaticResource Muted}" FontSize="11"
                                       FontWeight="SemiBold" Margin="2,34,0,10"/>
                        </StackPanel>

                        <!-- Cerrar sesión (abajo) -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Background="#26FFFFFF" Margin="0,0,0,12"/>
                            <Button Style="{StaticResource LogoutButton}" Click="Logout_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M9,21 H5 A2,2 0 0 1 3,19 V5 A2,2 0 0 1 5,3 H9 M16,17 L21,12 L16,7 M21,12 H9"/>
                                    <TextBlock Text="Cerrar sesión" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Opciones -->
                        <StackPanel>
                            <Button Style="{StaticResource NavButton}" Click="Inventario_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M3,7 L12,3 L21,7 L21,17 L12,21 L3,17 Z M3,7 L12,11 L21,7 M12,11 L12,21"/>
                                    <TextBlock Text="Inventario" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Ordenes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M9,4 H7 A2,2 0 0 0 5,6 V20 A2,2 0 0 0 7,22 H17 A2,2 0 0 0 19,20 V6 A2,2 0 0 0 17,4 H15 M9,2 H15 V6 H9 Z M9,12 H15 M9,16 H13"/>
                                    <TextBlock Text="Órdenes" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Clientes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M5,7 A4,4 0 1 0 13,7 A4,4 0 1 0 5,7 M2,21 V19 A4,4 0 0 1 6,15 H12 A4,4 0 0 1 16,19 V21 M16,3.1 A4,4 0 0 1 16,10.9 M22,21 V19 A4,4 0 0 0 19,15.1"/>
                                    <TextBlock Text="Clientes" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Click="Empleados_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M7,9 A2,2 0 1 0 11,9 A2,2 0 1 0 7,9 M5,16 A4,4 0 0 1 13,16 M15,9 H19 M15,13 H19"/>
                                    <TextBlock Text="Empleados" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ CONTENIDO ============ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Encabezado -->
                    <StackPanel Grid.Row="0" Margin="40,36,40,0">
                        <TextBlock x:Name="txtFecha" Foreground="{StaticResource SoftText}" FontSize="13"/>
                        <TextBlock Text="Panel principal" Foreground="{StaticResource DarkText}"
                                   FontSize="30" FontWeight="Bold" Margin="0,4,0,0"/>
                        <TextBlock Text="Selecciona un módulo para comenzar."
                                   Foreground="{StaticResource SoftText}" FontSize="14" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Tarjetas -->
                    <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="32,18,32,28">

                        <Button Style="{StaticResource CardButton}" Click="Inventario_Click">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left"
                                        Background="{StaticResource ButtonGradient}">
                                    <Path Style="{StaticResource CardIcon}"
                                          Data="M3,7 L12,3 L21,7 L21,17 L12,21 L3,17 Z M3,7 L12,11 L21,7 M12,11 L12,21"/>
                                </Border>
                                <TextBlock Text="Inventario" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}" Margin="0,16,0,4"/>
                                <TextBlock Text="Controla productos, existencias y movimientos."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SoftText}"/>
                                <TextBlock Text="Abrir  →" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Primary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Click="Ordenes_Click">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left"
                                        Background="{StaticResource ButtonGradient}">
                                    <Path Style="{StaticResource CardIcon}"
                                          Data="M9,4 H7 A2,2 0 0 0 5,6 V20 A2,2 0 0 0 7,22 H17 A2,2 0 0 0 19,20 V6 A2,2 0 0 0 17,4 H15 M9,2 H15 V6 H9 Z M9,12 H15 M9,16 H13"/>
                                </Border>
                                <TextBlock Text="Órdenes" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}" Margin="0,16,0,4"/>
                                <TextBlock Text="Crea y da seguimiento a las órdenes de tus clientes."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SoftText}"/>
                                <TextBlock Text="Abrir  →" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Primary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Click="Clientes_Click">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left"
                                        Background="{StaticResource ButtonGradient}">
                                    <Path Style="{StaticResource CardIcon}"
                                          Data="M5,7 A4,4 0 1 0 13,7 A4,4 0 1 0 5,7 M2,21 V19 A4,4 0 0 1 6,15 H12 A4,4 0 0 1 16,19 V21 M16,3.1 A4,4 0 0 1 16,10.9 M22,21 V19 A4,4 0 0 0 19,15.1"/>
                                </Border>
                                <TextBlock Text="Clientes" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}" Margin="0,16,0,4"/>
                                <TextBlock Text="Administra tu cartera de clientes y sus datos."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SoftText}"/>
                                <TextBlock Text="Abrir  →" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Primary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource CardButton}" Click="Empleados_Click">
                            <StackPanel>
                                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left"
                                        Background="{StaticResource ButtonGradient}">
                                    <Path Style="{StaticResource CardIcon}"
                                          Data="M4,4 H20 A2,2 0 0 1 22,6 V18 A2,2 0 0 1 20,20 H4 A2,2 0 0 1 2,18 V6 A2,2 0 0 1 4,4 Z M7,9 A2,2 0 1 0 11,9 A2,2 0 1 0 7,9 M5,16 A4,4 0 0 1 13,16 M15,9 H19 M15,13 H19"/>
                                </Border>
                                <TextBlock Text="Empleados" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}" Margin="0,16,0,4"/>
                                <TextBlock Text="Gestiona el personal y sus accesos al sistema."
                                           TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource SoftText}"/>
                                <TextBlock Text="Abrir  →" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Primary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Minimizar / cerrar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimizar">
                            <Path Data="M0,0 L10,0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Margin="0,8,0,0"/>
                        </Button>
                        <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="Cerrar">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>