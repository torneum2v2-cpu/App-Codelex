<Window x:Class="Codelex.SeleccionarCuenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codelex - Elegir cuenta"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="Line" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="Field" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8F8F"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CuentaButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Field}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="14,12">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20" CornerRadius="18" Background="{StaticResource BgGradient}" MouseLeftButtonDown="DragWindow">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1">
                <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimizar">
                    <Path Data="M0,0 L10,0"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" Margin="0,8,0,0"/>
                </Button>
                <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="Cerrar">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"/>
                </Button>
            </StackPanel>

            <StackPanel Margin="30">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Field}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                        HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Viewbox Width="34" Height="34">
                        <Path Stroke="{StaticResource Primary}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M20,21 V19 A4,4 0 0 0 16,15 H8 A4,4 0 0 0 4,19 V21 M8,7 A4,4 0 1 0 16,7 A4,4 0 1 0 8,7"/>
                    </Viewbox>
                </Border>

                <TextBlock Text="Elige una cuenta" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                <TextBlock Text="Entra con una de las cuentas guardadas en este equipo."
                           FontSize="13" Foreground="{StaticResource Muted}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock x:Name="txtError" Foreground="{StaticResource Danger}"
                           FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap"
                           TextAlignment="Center" Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340" Margin="0,18,0,0">
                    <StackPanel>
                        <ItemsControl x:Name="lista">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Button Style="{StaticResource CuentaButton}" Click="Cuenta_Click">
                                            <Grid Margin="0,0,34,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="42" Height="42" CornerRadius="21"
                                                        Background="{StaticResource Primary}">
                                                    <TextBlock Text="{Binding Iniciales}" FontSize="15"
                                                               FontWeight="Bold" Foreground="#06282B"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NombreCompleto}" FontSize="14.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Ink}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Usuario}" FontSize="12.5"
                                                               Foreground="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource WindowButton}" Click="Quitar_Click"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,10,0" ToolTip="Olvidar esta cuenta">
                                            <Path Data="M0,0 L9,9 M9,0 L0,9"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource CuentaButton}" Click="Agregar_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{StaticResource Field}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                                    <Viewbox Width="18" Height="18">
                                        <Path Data="M12,5 V19 M5,12 H19" Stroke="{StaticResource PrimaryLight}"
                                              StrokeThickness="2" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Agregar cuenta" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryLight}"
                                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Border>
</Window>