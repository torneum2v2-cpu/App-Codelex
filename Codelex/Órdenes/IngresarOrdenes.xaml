<Window x:Class="Codelex.IngresarOrden"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingresar orden" Height="800" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2CC5B4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#5FE0D2"/>
        <SolidColorBrush x:Key="Muted" Color="#8FC4BD"/>
        <SolidColorBrush x:Key="DarkText" Color="#0A3737"/>
        <SolidColorBrush x:Key="SoftText" Color="#5B7C78"/>
        <SolidColorBrush x:Key="Surface" Color="#F4F8F8"/>
        <SolidColorBrush x:Key="CardLine" Color="#DDEAE8"/>
        <SolidColorBrush x:Key="Hover" Color="#F3FCFA"/>
        <SolidColorBrush x:Key="Pill" Color="#E3F7F4"/>
        <SolidColorBrush x:Key="PillText" Color="#14837A"/>

        <LinearGradientBrush x:Key="BgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F4A40" Offset="0"/>
            <GradientStop Color="#0A3737" Offset="0.5"/>
            <GradientStop Color="#062529" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1FAFA5" Offset="0"/>
            <GradientStop Color="#2CC5B4" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#0A3737"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TituloCard" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Nota" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource SoftText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                    BorderThickness="1.5" CornerRadius="10">
                <Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource Primary}" StrokeThickness="1.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                                 ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                     ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                            Margin="12,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,10,10">
                                    <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                            BorderThickness="1.5" CornerRadius="10" Padding="0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#0A3737"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardLine}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Pill}"/>
                                <Setter Property="Foreground" Value="{StaticResource PillText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="4">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06282B"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource ButtonGradient}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1.5" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Primary}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="16">
        <Border CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource BgGradient}"
                        Padding="28,18,14,18" MouseLeftButtonDown="arrastrarVentana">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Volver"
                                    Width="46" Height="36" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path Data="M30,12 H2 M8,18 L2,12 L8,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="32" Height="14"/>
                            </Button>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource ButtonGradient}">
                                <Path Data="M9,3 H15 V6 H9 Z M7,5 H5 A1,1 0 0 0 4,6 V20 A1,1 0 0 0 5,21 H19 A1,1 0 0 0 20,20 V6 A1,1 0 0 0 19,5 H17 M8,13 L11,16 L16,10"
                                      Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                      Width="22" Height="22"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ingresar orden" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Crea y gestiona las solicitudes de limpieza y servicios." Foreground="{StaticResource Muted}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource WindowButton}" Click="minimizarClic" ToolTip="Minimizar">
                                <Path Data="M0,0 L10,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" Margin="0,8,0,0"/>
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="salirClic" ToolTip="Cerrar">
                                <Path Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" CornerRadius="0,0,14,14" Background="{StaticResource Surface}"/>

                <Grid Grid.Row="1" Margin="20,14,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Indicador de pasos -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,10" Margin="0,0,0,12">
                        <UniformGrid Columns="3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="Hand"
                                        Tag="1" MouseLeftButtonUp="pasoClic" Background="Transparent">
                                <Border x:Name="circulo1" Width="30" Height="30" CornerRadius="15" Background="{StaticResource Primary}">
                                    <TextBlock x:Name="numero1" Text="1" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="titulo1" Text="Cotización y cliente" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="Hand"
                                        Tag="2" MouseLeftButtonUp="pasoClic" Background="Transparent">
                                <Border x:Name="circulo2" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardLine}">
                                    <TextBlock x:Name="numero2" Text="2" Foreground="{StaticResource SoftText}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="titulo2" Text="Servicio y lugar" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource SoftText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Cursor="Hand"
                                        Tag="3" MouseLeftButtonUp="pasoClic" Background="Transparent">
                                <Border x:Name="circulo3" Width="30" Height="30" CornerRadius="15" Background="{StaticResource CardLine}">
                                    <TextBlock x:Name="numero3" Text="3" Foreground="{StaticResource SoftText}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="titulo3" Text="Equipo y revisión" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource SoftText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </Border>

                    <!-- Contenido de cada paso -->
                    <ScrollViewer x:Name="scrollPasos" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>

                            <!-- PASO 1: COTIZACIÓN Y CLIENTE -->
                            <Grid x:Name="panelPaso1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="430"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Cotización" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                                        <TextBlock Text="La orden se crea a partir de una cotización. Use la lupa para elegir otra."
                                                   Style="{StaticResource Nota}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Cotización:" Style="{StaticResource Etiqueta}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtCotizacion" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                                            <Button x:Name="btnCambiarCotizacion" Grid.Column="1" Width="38" Padding="0"
                                                    Style="{StaticResource PrimaryButton}" Click="cambiarCotizacionClic"
                                                    ToolTip="Elegir otra cotización">
                                                <Path Data="M11,4 A7,7 0 1 0 11,18 A7,7 0 1 0 11,4 M21,21 L16,16" Stroke="#06282B" StrokeThickness="2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                                                      Width="16" Height="16"/>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="Detalle cotizado:" Style="{StaticResource Etiqueta}"/>
                                        <ListBox x:Name="lstCotizacion" Height="200" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="txtTotalCotizacion" Style="{StaticResource Etiqueta}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="Cliente" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Los datos vienen de la cotización." Style="{StaticResource Nota}" Margin="0,0,0,10"/>

                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,10,8">
                                                <TextBlock Text="RTN / N.° de identidad:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtIdentidad" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Empresa:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtEmpresa" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,8">
                                                <TextBlock Text="Nombre del contacto:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtContacto" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Apellido del contacto:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtApellido" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Teléfono:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtTelefono" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Correo electrónico:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtCorreo" IsReadOnly="True"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- PASO 2: SERVICIO Y LUGAR -->
                            <Grid x:Name="panelPaso2" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="¿Cuándo?" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                            <!-- Siempre es "(automático)"; se mantiene oculto porque el código lo usa. -->
                                            <TextBox x:Name="txtNOrden" Text="(automático)" IsReadOnly="True" Visibility="Collapsed"/>

                                            <TextBlock Text="Fecha de solicitud:" Style="{StaticResource Etiqueta}"/>
                                            <DatePicker x:Name="dpFechaSolicitud" Margin="0,0,0,8"/>

                                            <TextBlock Text="Fecha de limpieza:" Style="{StaticResource Etiqueta}"/>
                                            <DatePicker x:Name="dpFechaLimpieza" Margin="0,0,0,8"/>

                                            <TextBlock Text="Estado:" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbEstado" SelectedIndex="0" Margin="0,0,0,8">
                                                <ComboBoxItem Content="Pendiente"/>
                                                <ComboBoxItem Content="En proceso"/>
                                                <ComboBoxItem Content="Completada"/>
                                            </ComboBox>

                                            <TextBlock Text="Supervisor:" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbSupervisor"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="¿Dónde?" Style="{StaticResource TituloCard}" Margin="0,0,0,10"/>

                                            <TextBlock Text="Locación:" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbLocacion" Margin="0,0,0,8"/>

                                            <TextBlock Text="Tipo de locación:" Style="{StaticResource Etiqueta}"/>
                                            <ComboBox x:Name="cmbTipoLocacion" Margin="0,0,0,8"/>

                                            <TextBlock Text="Dirección de la limpieza:" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtDireccionLimpieza" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <TextBlock Text="Descripción de la limpieza (opcional):" Style="{StaticResource Etiqueta}"/>
                                            <TextBox x:Name="txtDescripcionLimpieza" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="¿Qué servicio?" Style="{StaticResource TituloCard}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Todo se toma de la cotización. Los productos se descuentan del inventario y los equipos se asignan solos."
                                                   Style="{StaticResource Nota}" Margin="0,0,0,10"/>

                                        <TextBlock Text="Servicio:" Style="{StaticResource Etiqueta}"/>
                                        <TextBox x:Name="txtServicio" IsReadOnly="True" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                <TextBlock Text="Actividades de la orden:" Style="{StaticResource Etiqueta}" Margin="0,0,0,4"/>
                                                <ListBox x:Name="lstActividadesOrden" Height="300"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="Se necesita para esta orden:" Style="{StaticResource Etiqueta}" Margin="0,0,0,4"/>
                                                <ListBox x:Name="lstNecesidades" Height="300"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- PASO 3: EQUIPO Y REVISIÓN -->
                            <Grid x:Name="panelPaso3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,15,0" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="¿Quién lo hace?" Style="{StaticResource TituloCard}" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="lblPersonasNecesarias" Style="{StaticResource Nota}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Disponibles:" Style="{StaticResource Etiqueta}"/>
                                                <ListBox x:Name="lstEmpleadosDisponibles" Height="150"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                                <Button x:Name="btnAgregarEmpleado" Content=">" Style="{StaticResource SecondaryButton}" Width="35" Padding="0" Margin="0,0,0,3" Click="agregarEmpleadoClic"/>
                                                <Button x:Name="btnQuitarEmpleado" Content="&lt;" Style="{StaticResource SecondaryButton}" Width="35" Padding="0" Click="quitarEmpleadoClic"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Asignados:" Style="{StaticResource Etiqueta}"/>
                                                <ListBox x:Name="lstEmpleadosAsignados" Height="150"/>
                                            </StackPanel>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="0,10,0,0">
                                            <StackPanel Margin="0,0,5,0">
                                                <TextBlock Text="Turno:" Style="{StaticResource Etiqueta}"/>
                                                <ComboBox x:Name="cmbTurno"/>
                                            </StackPanel>
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Piso / área:" Style="{StaticResource Etiqueta}"/>
                                                <TextBox x:Name="txtPisoArea"/>
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Vehículo:" Style="{StaticResource Etiqueta}" Margin="0,8,0,5"/>
                                        <ComboBox x:Name="cmbVehiculo"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource Card}" Background="{StaticResource Hover}">
                                        <StackPanel>
                                            <TextBlock Text="Resumen de la orden" Style="{StaticResource TituloCard}" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="txtResumen" Foreground="{StaticResource DarkText}" FontSize="13"
                                                       TextWrapping="Wrap" LineHeight="20"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </ScrollViewer>

                    <!-- Barra inferior -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="txtErrorPaso" Visibility="Collapsed" Foreground="#C0392B" FontSize="13"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="btnCancelar" Content="Cancelar" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="cancelarClic"
                                        ToolTip="Cierra la ventana sin guardar la orden"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnAtras" Content="&lt; Atrás" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Visibility="Collapsed" Click="atrasClic"/>
                                <Button x:Name="btnSiguiente" Content="Siguiente >" Style="{StaticResource PrimaryButton}"
                                        MinWidth="140" Click="siguienteClic"/>
                                <Button x:Name="btnGuardarOrden" Content="Guardar orden" Style="{StaticResource PrimaryButton}"
                                        MinWidth="160" Visibility="Collapsed" Click="guardarOrdenClic"
                                        ToolTip="Guarda los datos del formulario como una orden nueva"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
